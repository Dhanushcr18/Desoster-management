PORT=3000
NODE_ENV=development

# Security: JWT secret required in production (min 32 chars). In development, an ephemeral secret is generated if blank.
JWT_SECRET=your-32-character-or-longer-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Keyless Routing Engine (defaults to public demo server; can be pointed to local OSRM instance)
OSRM_URL=https://router.project-osrm.org

# Autonomous Supply Resilience Agent Configuration
AGENT_INTERVAL_MIN=5
SIM_SPEED=60
BLOCKED_ROAD_DELAY_MIN=360

# Optional: Google Gemini AI API Key (Keyless fallback with deterministic templates used when unset)
GEMINI_API_KEY=

# Optional: Telegram Driver & Dispatch Notifications (Silent fallback when unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Optional: Weather API (Open-Meteo is keyless and used automatically; OpenWeather is optional)
OPENWEATHER_API_KEY=

# Optional: Twilio SMS (Optional fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
